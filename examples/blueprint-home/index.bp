page(favicon:"/favicon.ico") {
    title { "Blueprint - Modern UI Framework" }
    description { "A modern, declarative UI framework for building beautiful web interfaces" }
    keywords { "blueprint, ui, framework, web development" }
    author { "Blueprint Team" }
}

navbar {
    horizontal {
        link(href:index) { text(bold) { "Blueprint" } }
        links {
            link(href:index) { "Home" }
            link(href:components) { "Components" }
            link(href:about) { "About" }
            link(href:contact) { "Contact" }
        }
    }
}

section(wide, centered) {
    vertical(centered) {
        title(huge) { "Build modern UIs with Blueprint" }
        text(large, subtle) { "A declarative framework that compiles to clean HTML, CSS, and JavaScript" }

        horizontal {
            link(href:components) { button { "View Components" } }
            link(href:about) { button-light { "Learn More" } }
        }
    }
}

section(wide) {
    grid(columns:3) {
        card {
            title { "⚡ Live Development" }
            text { "Instant hot reload keeps your browser in sync with every code change" }
        }
        card {
            title { "🎨 Beautiful by Default" }
            text { "Shadcn-inspired dark theme with polished components out of the box" }
        }
        card {
            title { "📦 Zero Config" }
            text { "Start building immediately with sensible defaults and intuitive syntax" }
        }
    }
}

section(wide, centered) {
    vertical(centered) {
        title(large) { "Ready to get started?" }
        text(subtle) { "Explore our component library and start building today" }

        horizontal {
            link(href:components) { button { "Browse Components" } }
            link(href:contact) { button-secondary { "Get in Touch" } }
        }
    }
} 